{
  "name": "@peaske7/readit",
  "version": "0.4.0-rc.1",
  "description": "A CLI tool to review Markdown documents with inline comments",
  "author": "Jay Shimada <peaske@pm.me>",
  "license": "MIT",
  "keywords": [
    "markdown",
    "review",
    "cli",
    "comments",
    "documentation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "readit": "./dist/index.js"
  },
  "files": [
    "dist",
    "shell"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/cli.ts --",
    "dev:client": "bunx vite",
    "build": "bunx vite build && bun run build:cli",
    "build:cli": "NODE_ENV=production bun build src/cli.ts --outfile dist/index.js --target bun --format esm --packages external",
    "build:worker": "bun run build && rm -rf worker/public && mkdir -p worker/public && cp -r dist/assets worker/public/assets && cp dist/.vite/manifest.json worker/src/manifest.json",
    "worker:dev": "bun run build:worker && cd worker && wrangler dev",
    "worker:deploy": "bun run build:worker && cd worker && wrangler deploy",
    "start": "bun run build && bun dist/index.js",
    "test": "vitest run",
    "bench": "vitest bench",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --project=chromium --ui",
    "test:perf": "PERF_SETUP=1 playwright test --project=perf",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "prepack": "bun run build",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "lucide-svelte": "^0.577.0",
    "markdown-it": "^14.3.1",
    "mermaid": "^11.17.2",
    "open": "^11.0.2",
    "jsdom": "^28.1.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@cloudflare/workers-types": "^5.20260902.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@types/bun": "^1.4.0",
    "@types/jsdom": "^28.0.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^25.9.5",
    "lefthook": "^2.1.12",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
